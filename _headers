/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://push2delay.eastmoney.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/public/data/latest.json
  Cache-Control: public, max-age=0, must-revalidate

/public/images/latest.png
  Cache-Control: public, max-age=0, must-revalidate

/data/company-profiles.json
  Cache-Control: public, max-age=86400

/public/data/ah-pairs.json
  Cache-Control: public, max-age=3600
